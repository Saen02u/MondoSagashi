# PostgreSQL Database Settings
# 로컬 개발 환경 또는 Docker Compose 실행 시 사용되는 환경변수입니다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_archive
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Full JDBC URL (선택 사항: 지정 시 DB_HOST/PORT 대신 우선 적용됨)
# DB_URL=jdbc:postgresql://localhost:5432/youtube_archive

# Hibernate DDL 전략 (개발 환경: update, 운영 환경: validate 권장)
JPA_DDL_AUTO=update

# YouTube Data API v3 (향후 연동 시 추가)
# YOUTUBE_API_KEY=your_youtube_api_key_here
