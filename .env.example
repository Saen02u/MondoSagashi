# ==============================================================================
# YouTube Live Archive - 통합 환경설정 가이드 (.env.example)
# ==============================================================================
# 본 파일은 로컬 개발, Docker Compose, 운영 클라우드 환경에 필요한 모든 환경변수 명세입니다.
# 실제 비밀정보(API 키, 비밀번호)는 .env 파일 또는 GitHub Secrets/호스팅 환경변수로 관리하며
# 절대 Git 저장소에 커밋하지 마십시오.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 데이터베이스 접속 설정 (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_archive
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# (선택) 전체 JDBC URL이 주어질 경우 DB_HOST/PORT 대신 우선 적용됩니다.
# AWS RDS / Neon / Supabase 등 풀 커넥션 스트링 제공 플랫폼에서 유용합니다.
# DB_URL=jdbc:postgresql://ep-example.region.aws.neon.tech:5432/youtube_archive?sslmode=require

# Hibernate DDL 관리 전략
# - 개발 환경(dev/local): update (엔티티 변경 시 자동 DDL 반영)
# - 운영 환경(prod): validate (운영 DB의 무단 테이블 변경 방지, 스키마 마이그레이션 도구 권장)
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. 관리자 인증 및 보안 설정 (Spring Security & Cookie)
# ------------------------------------------------------------------------------
# 초기 관리자 계정 정보 (첫 부팅 시 DataInitializer에 의해 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_strong_admin_password_123!

# 세션 쿠키 보안 플래그
# - 로컬 개발 (HTTP): false
# - 운영 배포 (HTTPS): true (HTTPS 전송 강제)
COOKIE_SECURE=false

# 쿠키 SameSite 정책: Lax (동일 사이트 및 일반 링크) 또는 None (프론트/백엔드 분리 도메인 시 + Secure 필수)
COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 연동
# ------------------------------------------------------------------------------
# Google Cloud Console에서 발급받은 YouTube Data API v3 서버 키
# 키 발급: https://console.cloud.google.com/apis/credentials
# (할당량 보호를 위해 IP 제한 또는 HTTP Referrer 제한 권장)
YOUTUBE_API_KEY=AIzaSyYourRealYouTubeApiKeyHere12345

# ------------------------------------------------------------------------------
# 4. CORS 및 네트워크 설정
# ------------------------------------------------------------------------------
# 쉼표(,)로 구분된 허용 오리진 목록 (CORS)
# 예: http://localhost:3000,https://my-youtube-archive.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# Spring 활성 프로파일 (local, dev, prod, docker)
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 5. 프론트엔드 환경변수 (Vite - VITE_ 접두사 필수)
# ------------------------------------------------------------------------------
# 프론트엔드가 백엔드 API와 통신할 베이스 URL
# - 동일 오리진 프록시 사용 시: 빈 문자열 또는 /api
# - 백엔드가 별도 도메인으로 분리 배포된 경우: https://api.yourdomain.com
VITE_API_BASE_URL=
